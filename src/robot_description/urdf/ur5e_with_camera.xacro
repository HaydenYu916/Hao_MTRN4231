<?xml version="1.0" ?>
<!-- ============================================================
     UR5e Robot with Camera Calibration
     Description:
       - Only defines base_link → camera_link transform
       - Camera link is published by RealSense driver
       - Use static_transform_publisher in launch file
     ============================================================ -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="ur5e_with_camera">
  
  <!-- Note: This file only documents the camera transform relationship.
       The actual base_link → camera_link transform is published by 
       static_transform_publisher in display_with_camera.launch.py
       
       Transform parameters (from hand-to-eye calibration):
       - Position: x=1.29163m, y=0.0146956m, z=0.665489m
       - Quaternion: qx=-0.396568, qy=-0.0131018, qz=0.91791, qw=-0.00187618
       - RPY: roll=0.0372615, pitch=-0.815369, yaw=-3.12141
  -->

</robot>
